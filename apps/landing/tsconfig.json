{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `test` is excluded here and picked up by `tsconfig.test.json` instead, the
  // same split `apps/web` uses. It is not only about keeping specs out of
  // `next build`: this config has no path to `@thinkclear/shared`, so app code
  // that imported a workspace package would fail to compile. The rule that this
  // app depends on nothing else in the repository is enforced by that absence,
  // and the specs — which do reach for shared, to check the facts this site
  // restates have not drifted — are the one place it is opened up.
  "exclude": ["node_modules", "test"]
}
