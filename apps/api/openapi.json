        ]
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "ChatController_chat",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI SDK UI message event stream (SSE). Assistant text and mindmap tool calls arrive as streamed message parts.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Body failed validation"
          },
          "404": {
            "description": "No conversation with that id belongs to the caller"
          },
          "503": {
            "description": "LLM_GATEWAY_API_KEY is not configured on the server"
          }
        },
        "tags": [
          "chat"
        ]
      }
    },
    "/api/mcp": {
      "post": {
        "operationId": "McpController_post",
        "parameters": [],
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response. Streams as SSE when the exchange emits progress before its result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token. Carries the RFC 9728 WWW-Authenticate challenge pointing at the protected resource metadata."
          },
          "403": {
            "description": "The token is valid but lacks a required scope"
          }
        },
        "tags": [
          "mcp"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/me/preferences": {
      "patch": {
        "operationId": "MeController_updatePreferences",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesDto"
                }
              }
            }
          },
          "400": {
            "description": "Body failed validation"
          }
        },
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "ThinkClear API",
    "description": "ThinkClear app API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "description": "The Mongo connection's state",
            "example": "connected"
          },
          "uptime": {
            "type": "number",
            "description": "Seconds since this process started",
            "example": 1837
          }
        },
        "required": [
          "status",
          "database",
          "uptime"
        ]
      },
      "MindmapNodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "root",
            "description": "Unique within the mindmap. The node with id \"root\" is the map's root and cannot be removed."
          },
          "title": {
            "type": "string",
            "example": "Backend",
            "minLength": 1,
            "maxLength": 200
          },
          "x": {
            "type": "number",
            "example": 0,
            "description": "Canvas position. The editor lays the tree out from scratch on load, so this is a hint about sibling order rather than a fixed coordinate."
          },
          "y": {
            "type": "number",
            "example": 0
          },
          "note": {
            "type": "string",
            "example": "Ship the **API** first, then the canvas.",
            "maxLength": 5000,
            "description": "The topic's note, as markdown source. Omitted when the topic has no note — an empty string is not stored."
          }
        },
        "required": [
          "id",
          "title",
          "x",
          "y"
        ]
      },
      "MindmapEdgeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique within the mindmap"
          },
          "source": {
            "type": "string",
            "description": "Node id the edge starts from"
          },
          "target": {
            "type": "string",
            "description": "Node id the edge points to. Direction is presentation only — the editor re-points edges parent to child when it lays the tree out."
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ]
      },
      "MindmapDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MindmapNodeDto"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MindmapEdgeDto"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "title",
          "ownerId",
          "nodes",
          "edges",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateMindmapDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My first mindmap"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateMindmapDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Renamed mindmap",
            "minLength": 1,
            "maxLength": 200
          },
          "nodes": {
            "maxItems": 500,
            "description": "Replaces every node. Ids must be unique and one of them must be \"root\".",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MindmapNodeDto"
            }
          },
          "edges": {
            "maxItems": 1000,
            "description": "Replaces every edge. Ids must be unique, both endpoints must be nodes of this mindmap, and the result must stay a tree: no self-connections, no node pair connected twice, and no loops. Disconnected branches are allowed.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MindmapEdgeDto"
            }
          }
        }
      },
      "ConversationSummaryDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "description": "Bumped by every chat turn, so it doubles as the last-used time the history list sorts on."
          }
        },
        "required": [
          "_id",
          "title",
          "ownerId",
          "createdAt",
          "updatedAt"
        ]
      },
      "ConversationDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "description": "Bumped by every chat turn, so it doubles as the last-used time the history list sorts on."
          },
          "messages": {
            "type": "array",
            "description": "AI SDK UIMessage array. See https://ai-sdk.dev — the shape is owned by the `ai` package and stored as sent.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "_id",
          "title",
          "ownerId",
          "createdAt",
          "updatedAt",
          "messages"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Plan a launch mindmap",
            "minLength": 1,
            "maxLength": 200,
            "description": "Defaults to \"New chat\". The web app passes the first message, shortened."
          }
        }
      },
      "UpdateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Launch planning",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Chat session id from the AI SDK"
          },
          "conversationId": {
            "type": "string",
            "description": "Conversation this turn belongs to. Must be one of the caller's own conversations; the route appends the turn to it. Create one with POST /api/conversations first."
          },
          "mindmapId": {
            "type": "string",
            "nullable": true,
            "description": "Id of the mindmap currently open in the canvas, used as conversation context"
          },
          "messages": {
            "type": "array",
            "description": "AI SDK UIMessage array. See https://ai-sdk.dev — the shape is owned by the `ai` package and streamed back as a UI message event stream.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "conversationId",
          "messages"
        ]
      },
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "PreferencesDto": {
        "type": "object",
        "properties": {
          "layoutDirection": {
            "type": "string",
            "enum": [
              "down",
              "right"
            ],
            "example": "down",
            "description": "Which way a mindmap grows from its root: \"down\" the screen or \"right\" across it. Every preference is answered at its default, so a person who has never changed one still gets a complete object."
          }
        },
        "required": [
          "layoutDirection"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          },
          "socialProviders": {
            "type": "array",
            "example": [
              "google"
            ],
            "items": {
              "type": "string",
              "enum": [
                "google"
              ]
            }
          },
          "preferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          }
        },
        "required": [
          "user",
          "socialProviders",
          "preferences"
        ]
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "layoutDirection": {
            "type": "string",
            "enum": [
              "down",
              "right"
            ],
            "example": "right"
          }
        }
      }
    }
  }
}