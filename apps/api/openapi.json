{
  "openapi": "3.0.0",
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/mindmaps": {
      "get": {
        "operationId": "MindmapsController_findMine",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MindmapDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "mindmaps"
        ]
      },
      "post": {
        "operationId": "MindmapsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMindmapDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MindmapDto"
                }
              }
            }
          }
        },
        "tags": [
          "mindmaps"
        ]
      }
    }
  },
  "info": {
    "title": "Mindmap API",
    "description": "Mindmap app API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "MindmapDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "title",
          "ownerId",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateMindmapDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My first mindmap"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  }
}