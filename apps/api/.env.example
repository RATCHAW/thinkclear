MONGODB_URI=mongodb://localhost:27017/thinkclear
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
# Origins allowed to drive this API, comma-separated. APP_URL is always
# trusted, so this is only for the extras: an apex and its www, or Vercel's
# per-branch preview URLs, which Better Auth will match as a wildcard —
# https://*-your-team.vercel.app
CLIENT_ORIGIN=http://localhost:5173
PORT=3000

# HTTP basic auth on Swagger UI (/docs) and the raw spec beside it. The docs
# enumerate every route on a public host, so they are credentialed rather than
# open. Leave either blank and /docs is not served at all — a deployment that
# forgets these loses its docs, which is noticed, instead of publishing them,
# which is not. `pnpm openapi` does not go through here.
DOCS_USER=docs
DOCS_PASSWORD=docs

# The app's public origin — where a browser and an MCP client both arrive.
# It is the web server's address, not this API's: /api is proxied here (vite
# in dev, nginx in the image), and Better Auth's OAuth flow redirects to the
# /sign-in and /consent pages, which the web app serves. Getting this wrong
# sends an authorizing user to a 404.
APP_URL=http://localhost:5173

# MCP (POST /api/mcp). Agent clients connect to this URL, and access tokens
# are audience-bound to it, so it must be the address they actually use.
# Defaults to $APP_URL/api/mcp.
MCP_RESOURCE_URL=
# Where this API fetches the keys it verifies MCP access tokens with.
# Defaults to $APP_URL/api/auth/jwks, which is right whenever that origin is
# reachable from the API. Set it to the API's own address when it is not —
# behind a proxy the API sits *behind*, that public origin does not resolve
# from in here. In the compose stack: http://localhost:3000/api/auth/jwks
MCP_JWKS_URL=

# AI chat (POST /api/chat). Every model is reached through LLM Gateway,
# which speaks the AI SDK's own gateway protocol. Without this key the chat
# route answers 503; everything else works. Get one from https://llmgateway.io
LLM_GATEWAY_API_KEY=
# Any model the gateway routes, written vendor/model so the vendor is pinned.
AI_CHAT_MODEL=deepseek/deepseek-v4-flash
# Only for a self-hosted gateway. The path carries the AI SDK major it answers
# for: /v4/ai is AI SDK 7. Defaults to https://api.llmgateway.io/v4/ai.
LLM_GATEWAY_URL=
