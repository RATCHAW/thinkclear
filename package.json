{
  "name": "thinkclear",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "openapi": "turbo run openapi generate:types",
    "test": "vitest run",
    "test:spec": "vitest run --project shared:spec --project api:spec --project web:spec",
    "test:e2e": "vitest run --project api:e2e --project web:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:install-browser": "pnpm --filter @thinkclear/web exec playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.5.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright"
    ]
  }
}
