{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "openapi": {
      "dependsOn": ["^build"],
      "env": ["MONGODB_URI", "BETTER_AUTH_SECRET"],
      "outputs": ["openapi.json"]
    },
    "generate:types": {
      "dependsOn": ["@thinkclear/api#openapi"],
      "outputs": ["src/lib/api-types.d.ts"]
    }
  }
}
