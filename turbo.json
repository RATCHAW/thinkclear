{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "openapi": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "generate:types": {
      "dependsOn": ["@mindmap/api#openapi"],
      "outputs": ["src/lib/api-types.d.ts"]
    }
  }
}
